{
  "name": "voyage-agent-native-travel-itinerary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:e2e": "VOYAGE_DB_PATH=.data/voyage.playwright.sqlite next start -p 3100",
    "test:e2e": "pnpm build && playwright test",
    "test:webmcp": "pnpm build && playwright test --config=playwright.webmcp.config.ts tests/e2e/webmcp.spec.ts",
    "format": "oxfmt"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^16.3.5",
    "openai": "^7.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
